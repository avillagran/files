+    /// Set an upper bound on the sum of progressive coefficient Vec payloads.
+    /// Checked before any of those Vecs are allocated; excludes allocator overhead,
+    /// output planes, row buffers, metadata, and compressed input. Not a PSS cap.
+    pub fn set_max_coefficient_buffer_size(&mut self, max: usize) {
+        self.coefficient_buffer_size_limit = max;
+    }
+
+    /// Enable or disable per-component workers and parallel color conversion.
+    /// Opt-in low-frequency preview for progressive images at exactly 1/8
+    /// scale. Stores one DC coefficient per padded block, skips AC entropy,
+    /// validates DC scan/refinement ordering. This deliberately does NOT
+    /// validate ignored AC entropy and must not be used as an integrity check.
+    pub fn set_progressive_dc_preview(&mut self, enabled: bool) {
+        self.progressive_dc_preview = enabled;
+    }
