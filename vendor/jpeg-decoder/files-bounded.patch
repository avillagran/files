+#[cfg(test)]
+mod files_bounded_tests {
+    use super::*;
+    use std::io::Cursor;
+
+    fn frame(width: u16, height: u16) -> FrameInfo {
+        let mut data = vec![0, 17, 8];
+        data.extend_from_slice(&height.to_be_bytes());
+        data.extend_from_slice(&width.to_be_bytes());
+        data.extend_from_slice(&[3, 1, 0x22, 0, 2, 0x11, 0, 3, 0x11, 0]);
+        parse_sof(&mut Cursor::new(data), Marker::SOF(2)).unwrap()
+    }
+    #[test]
+    fn dc_preview_coefficient_budget_counts_one_i16_per_block() {
+        let frame = frame(6000, 4000);
+        let blocks = frame
+            .components
+            .iter()
+            .map(|c| c.block_size.width as usize * c.block_size.height as usize)
+            .sum::<usize>();
+        let mut decoder = Decoder::new(Cursor::new(&[]));
+        decoder.set_progressive_dc_preview(true);
+        decoder.set_max_coefficient_buffer_size(blocks * 2 - 1);
+        assert!(decoder.check_coefficient_buffer_size(&frame).is_err());
+        decoder.set_max_coefficient_buffer_size(blocks * 2);
+        assert!(decoder.check_coefficient_buffer_size(&frame).is_ok());
+        decoder.set_progressive_dc_preview(false);
+        assert!(decoder.check_coefficient_buffer_size(&frame).is_err());
+    }
+    #[test]
+    fn coefficient_budget_checked_sum_and_exact_boundary() {
+        let frame = frame(6000, 4000);
+        let bytes = 6000usize * 4000 * 3;
+        let mut decoder = Decoder::new(Cursor::new(&[]));
+        decoder.set_max_coefficient_buffer_size(bytes - 1);
+        assert!(decoder.check_coefficient_buffer_size(&frame).is_err());
+        decoder.set_max_coefficient_buffer_size(bytes);
+        assert!(decoder.check_coefficient_buffer_size(&frame).is_ok());
+    }
+    #[test]
+    fn immediate_policy_overrides_large_frame_and_output_limit_follows_scale() {
+        let mut frame = frame(6000, 4000);
+        let mut decoder = Decoder::new(Cursor::new(&[]));
+        decoder.set_parallel_decoding(false);
+        assert!(matches!(
+            decoder.select_worker(&frame, PreferWorkerKind::Multithreaded),
+            PreferWorkerKind::Immediate
+        ));
+        decoder.set_max_decoding_buffer_size(3 * 1024 * 1024);
+        assert!(decoder.check_decoding_buffer_size(&frame).is_err());
+        frame.update_idct_size(1).unwrap();
+        assert!(decoder.check_decoding_buffer_size(&frame).is_ok());
+    }
+    #[test]
+    fn progressive_zero_budget_fails_before_any_coefficient_allocation() {
+        let data = [
+            0xff, 0xd8, 0xff, 0xc2, 0, 11, 8, 0, 16, 0, 16, 1, 1, 0x11, 0, 0xff, 0xda, 0, 8, 1, 1,
+            0, 0, 0, 0, 0xff, 0xd9,
+        ];
+        let mut decoder = Decoder::new(Cursor::new(data));
+        decoder.set_parallel_decoding(false);
+        decoder.set_max_coefficient_buffer_size(0);
+        let error = decoder.decode().unwrap_err().to_string();
+        assert!(error.contains("coefficient buffer"), "{}", error);
+        assert!(decoder.coefficients.is_empty());
+    }
+    #[test]
+    fn output_zero_budget_fails_before_any_worker_plane_allocation() {
+        let data = [
+            0xff, 0xd8, 0xff, 0xc0, 0, 11, 8, 0, 16, 0, 16, 1, 1, 0x11, 0, 0xff, 0xda, 0, 8, 1, 1,
+            0, 0, 63, 0, 0xff, 0xd9,
+        ];
+        let mut decoder = Decoder::new(Cursor::new(data));
+        decoder.set_parallel_decoding(false);
+        decoder.set_max_decoding_buffer_size(0);
+        let error = decoder.decode().unwrap_err().to_string();
+        assert!(error.contains("decoded image"), "{}", error);
+    }
